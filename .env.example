# Kopier til .env og tilpass. Verdiene under er ufarlige eksempler for lokal utvikling.
# .env leses av apps/app og packages/db. Ikke commit .env.

# Lokal Postgres fra docker-compose.yml
DATABASE_URL=postgres://esaf:esaf_local_dev@localhost:5432/esaf
TEST_DATABASE_URL=postgres://esaf:esaf_local_dev@localhost:5432/esaf_test

# Better Auth. Lag en egen hemmelighet med: openssl rand -base64 32
BETTER_AUTH_SECRET=bytt-meg-ut-med-minst-32-tilfeldige-tegn
BETTER_AUTH_URL=http://localhost:3000

# E-post. Tom: ingen e-post, registrering og «Glemt passord?» er stengt, og folk
# kommer inn med en invitasjon som admin deler selv (pnpm admin:invite, eller
# Admin → Invitasjoner). `console` skriver e-postene med lenkene i terminalen, så
# registrering, invitasjoner og «Glemt passord?» kan prøves lokalt. Ikke lov i
# produksjon. `cloudflare` sender med Cloudflare Email Service (se README, «E-post»).
# EMAIL_PROVIDER=console
#
# Med EMAIL_PROVIDER=cloudflare: konto-ID-en (32 tegn, fra Cloudflare-dashbordet)
# og en API-nøkkel med tillatelsen «Email Sending: Send».
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_EMAIL_API_TOKEN=
#
# Avsender («Navn <adresse>» eller bare adressen). Domenet må være satt opp for
# sending i Cloudflare. Standard: ESAF <post@esaf.no>. Svar går til avsenderen,
# eller til EMAIL_REPLY_TO.
# EMAIL_FROM=ESAF <post@esaf.no>
# EMAIL_REPLY_TO=

# Profilbilder. Uten S3_-variablene lagres de på disk i .data/uploads (bare i
# utvikling; endre med UPLOAD_DIR). I produksjon er S3-kompatibel lagring påkrevd,
# f.eks. Cloudflare R2 med en privat bøtte:
# S3_ENDPOINT=https://<konto-id>.r2.cloudflarestorage.com
# S3_BUCKET=esaf-bilder
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
