# Kopier til .env og tilpass. Verdiene under er ufarlige eksempler for lokal utvikling.
# .env leses av apps/app og packages/db. Ikke commit .env.

# Lokal Postgres fra docker-compose.yml
DATABASE_URL=postgres://esaf:esaf_local_dev@localhost:5432/esaf
TEST_DATABASE_URL=postgres://esaf:esaf_local_dev@localhost:5432/esaf_test

# Better Auth. Lag en egen hemmelighet med: openssl rand -base64 32
BETTER_AUTH_SECRET=bytt-meg-ut-med-minst-32-tilfeldige-tegn
BETTER_AUTH_URL=http://localhost:3000

# E-post. Tom: ingen e-post, registrering er stengt, og folk kommer inn med en
# invitasjon (pnpm admin:invite, eller Admin → Invitasjoner). `console` skriver
# bekreftelseslenkene i terminalen, så registrering med e-post kan prøves lokalt.
# Ikke lov i produksjon.
# EMAIL_PROVIDER=console

# Profilbilder. Uten S3_-variablene lagres de på disk i .data/uploads (bare i
# utvikling; endre med UPLOAD_DIR). I produksjon er S3-kompatibel lagring påkrevd,
# f.eks. Cloudflare R2 med en privat bøtte:
# S3_ENDPOINT=https://<konto-id>.r2.cloudflarestorage.com
# S3_BUCKET=esaf-bilder
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
