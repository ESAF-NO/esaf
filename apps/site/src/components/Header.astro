---
const links = [
  { href: '/#om', label: 'Om ESAF' },
  { href: '/#fellesskap', label: 'Hva vi gjør' },
  { href: '/sponsorer', label: 'Sponsorer' },
  { href: '/#kontakt', label: 'Kontakt' },
]
---

<header class="header">
  <div class="wrap bar">
    <a href="/" class="wordmark" aria-label="ESAF, til forsiden">
      ESAF
    </a>
    <nav aria-label="Hovedmeny">
      <ul>
        {links.map((l) => (
          <li>
            <a href={l.href}>{l.label}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 5;
    background: var(--paper);
    border-bottom: 1px solid var(--line);
  }
  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    padding-block: 0.85rem;
  }
  .wordmark {
    font-family: var(--serif);
    font-weight: 600;
    font-size: 1.5rem;
    letter-spacing: 0.02em;
    color: var(--ink);
    text-decoration: none;
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.75rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  nav a {
    color: var(--ink);
    text-decoration: none;
    font-size: 0.95rem;
    padding-block: 0.35rem;
    display: inline-block;
  }
  nav a:hover {
    color: var(--accent);
    text-decoration: underline;
  }
  @media (max-width: 34rem) {
    .header {
      position: static;
    }
    .bar {
      flex-direction: column;
      align-items: flex-start;
    }
    ul {
      gap: 0.1rem 1.1rem;
    }
  }
</style>
