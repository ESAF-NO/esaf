---
const links = [
  { href: '/#om', label: 'Om ESAF' },
  { href: '/#fellesskap', label: 'Hva vi gjør' },
  { href: '/#appen', label: 'ESAF-appen' },
  { href: '/#kontakt', label: 'Kontakt' },
]
---

<header class="header">
  <div class="wrap bar">
    <a href="/" class="wordmark" aria-label="ESAF, til forsiden">
      ESAF
    </a>
    <nav aria-label="Hovedmeny">
      <ul>
        {links.map((l) => (
          <li>
            <a href={l.href}>{l.label}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 5;
    background: color-mix(in srgb, var(--paper) 92%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--line);
  }
  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    padding-block: 0.9rem;
  }
  .wordmark {
    font-weight: 900;
    font-size: 1.25rem;
    letter-spacing: 0.16em;
    color: var(--ink);
    text-decoration: none;
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  nav a {
    color: var(--ink-soft);
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 500;
    padding-block: 0.35rem;
    display: inline-block;
  }
  nav a:hover {
    color: var(--accent);
    text-decoration: underline;
  }
  @media (max-width: 34rem) {
    .header {
      position: static;
    }
    .bar {
      flex-direction: column;
      align-items: flex-start;
    }
    ul {
      gap: 0.1rem 1rem;
    }
  }
</style>
