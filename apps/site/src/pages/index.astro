---
import Footer from '../components/Footer.astro'
import Header from '../components/Header.astro'
import Base from '../layouts/Base.astro'
import { siteConfig } from '../site.config'

const planned = [
  { title: 'Profiler og kull', text: 'Finn igjen folk fra ditt eget og andre kull.' },
  {
    title: 'Medlemskatalog',
    text: 'Se hvem som kan hjelpe med et spørsmål eller en introduksjon.',
  },
  { title: 'ESAF-jobber', text: 'Stillinger og oppdrag delt i nettverket.' },
  { title: 'Kalender og nyhetsbrev', text: 'Ett sted for det som skjer i foreningen.' },
  { title: 'Syretestarkiv', text: 'Erfaringer fra tidligere syretester, samlet og søkbart.' },
  { title: 'Investorbase', text: 'Oversikt over investorer med tilknytning til miljøet.' },
]
---

<Base>
  <Header />
  <main id="innhold">
    <section class="hero" aria-labelledby="hero-title">
      <div class="wrap">
        <p class="eyebrow keep-case">{siteConfig.fullName}</p>
        <h1 id="hero-title">Nettverket som varer etter Entreprenørskolen.</h1>
        <p class="lead">
          ESAF samler folk fra NTNUs Entreprenørskole. På tvers av kull deler studenter og alumni
          erfaringer, hjelper hverandre med nye ideer og bygger forbindelser som varer etter
          studietiden.
        </p>
        <p class="cta">
          <a class="button" href="#kontakt">
            Ta kontakt
          </a>
          <a class="button ghost" href="#om">
            Les mer om ESAF
          </a>
        </p>
      </div>
    </section>

    <section id="om" class="section" aria-labelledby="om-title">
      <div class="wrap split">
        <div>
          <p class="eyebrow">Om ESAF</p>
          <h2 id="om-title">Fra studieprogram til livslangt nettverk</h2>
        </div>
        <div>
          <p>
            NTNUs Entreprenørskole er et toårig masterprogram i entreprenørskap ved NTNU i
            Trondheim. Studentene kombinerer fag i strategi, økonomi og forretningsutvikling med å
            bygge et eget selskap i tverrfaglige team.
          </p>
          <p>
            ESAF er et tverrfaglig nettverk av studenter og alumni fra Entreprenørskolen. Ifølge
            NTNU fortsetter om lag halvparten av kandidatene med selskapet de startet under studiet.
            Det er mye erfaring å dele, og ESAF gjør det lettere å finne hverandre etter
            studietiden.
          </p>
          <p>
            <a href={siteConfig.schoolUrl}>Les om studiet hos NTNU</a>
          </p>
        </div>
      </div>
    </section>

    <section id="fellesskap" class="section tint" aria-labelledby="fellesskap-title">
      <div class="wrap">
        <p class="eyebrow">Hva vi gjør</p>
        <h2 id="fellesskap-title">Møteplasser for studenter og alumni</h2>
        <p class="intro">
          Gjennom ESAF-helg, faglige samtaler og sosiale samlinger møtes folk som bygger selskaper,
          utforsker nye muligheter og vil hjelpe neste kull videre.
        </p>
        <div class="cards">
          <article>
            <h3>ESAF-helg</h3>
            <p>
              En helg i Trondheim der alumni og studenter møtes, med workshops og veiledning av
              teamene som går på Entreprenørskolen nå.
            </p>
          </article>
          <article>
            <h3>ESAF-talks</h3>
            <p>Faglige samtaler der folk fra nettverket deler erfaringer med hverandre.</p>
          </article>
          <article>
            <h3>Sosiale samlinger</h3>
            <p>Sosiale arrangementer som holder kontakten ved like, på tvers av kull.</p>
          </article>
        </div>
      </div>
    </section>

    <section id="appen" class="section" aria-labelledby="appen-title">
      <div class="wrap">
        <div class="future">
          <p class="tag">Under utvikling – ikke lansert</p>
          <h2 id="appen-title">ESAF-appen</h2>
          <p>
            På generalforsamlingen i 2025 fikk styret i oppdrag å undersøke bedre måter å nå
            medlemmene på, og en løsning for ESAF-jobber. Vi jobber derfor med en egen, lukket app
            for godkjente medlemmer.
          </p>
          <p class="muted">
            Dette er planer, ikke eksisterende tilbud. Innhold og rekkefølge kan endres.
          </p>
          <ul class="planned" aria-label="Planlagt innhold i ESAF-appen">
            {planned.map((p) => (
              <li>
                <strong>{p.title}</strong>
                <span>{p.text}</span>
              </li>
            ))}
          </ul>
          <p class="muted small">
            Medlemsinformasjon blir bare tilgjengelig inne i appen for godkjente medlemmer, aldri på
            denne siden.
          </p>
        </div>
      </div>
    </section>

    <section id="kontakt" class="section tint" aria-labelledby="kontakt-title">
      <div class="wrap split">
        <div>
          <p class="eyebrow">Kontakt</p>
          <h2 id="kontakt-title">Ta kontakt med styret</h2>
        </div>
        <div>
          {siteConfig.contactEmail ? (
            <p class="contact">
              Spørsmål om foreningen, arrangementer eller samarbeid? Send en e-post til{' '}
              <a href={`mailto:${siteConfig.contactEmail}`}>{siteConfig.contactEmail}</a>.
            </p>
          ) : (
            <p class="contact">Kontaktadressen til styret publiseres her før lansering.</p>
          )}
          {siteConfig.facebookUrl && (
            <p>
              Du finner oss også på <a href={siteConfig.facebookUrl}>Facebook</a>.
            </p>
          )}
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Base>

<style>
  .hero {
    padding-block: clamp(4rem, 12vw, 9rem) clamp(3rem, 8vw, 6rem);
    border-bottom: 1px solid var(--line);
  }
  .hero h1 {
    max-width: 16ch;
  }
  .lead {
    font-size: clamp(1.15rem, 2.2vw, 1.4rem);
    color: var(--ink-soft);
    max-width: 34rem;
    margin-top: 1.5rem;
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }
  .button {
    display: inline-block;
    padding: 0.8rem 1.4rem;
    border: 2px solid var(--ink);
    border-radius: 999px;
    background: var(--ink);
    color: var(--paper);
    font-weight: 600;
    text-decoration: none;
  }
  .button:hover {
    background: var(--accent);
    border-color: var(--accent);
  }
  .button.ghost {
    background: transparent;
    color: var(--ink);
  }
  .button.ghost:hover {
    color: var(--paper);
  }

  .section {
    padding-block: clamp(3.5rem, 9vw, 6.5rem);
  }
  .tint {
    background: var(--paper-deep);
  }
  .split {
    display: grid;
    gap: 1rem 4rem;
  }
  @media (min-width: 52rem) {
    .split {
      grid-template-columns: 1fr 1.4fr;
    }
  }

  .intro {
    font-size: 1.15rem;
    color: var(--ink-soft);
  }
  .cards {
    display: grid;
    gap: 1.5rem;
    margin-top: 2.5rem;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
  }
  .cards article {
    border-top: 3px solid var(--ink);
    padding-top: 1.25rem;
  }

  .future {
    border: 2px dashed var(--muted);
    border-radius: 1rem;
    padding: clamp(1.5rem, 5vw, 3.5rem);
  }
  .tag {
    display: inline-block;
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink);
    background: var(--paper-deep);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.25rem 0.8rem;
  }
  .muted {
    color: var(--muted);
  }
  .small {
    font-size: 0.95rem;
  }
  .planned {
    list-style: none;
    padding: 0;
    margin: 2rem 0;
    display: grid;
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
  }
  .planned li {
    background: var(--paper);
    padding: 1.1rem 1.25rem;
    display: grid;
    gap: 0.25rem;
  }
  .planned span {
    color: var(--ink-soft);
    font-size: 0.95rem;
  }
  .contact {
    font-size: 1.2rem;
  }
</style>
