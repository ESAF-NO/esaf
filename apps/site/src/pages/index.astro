---
import { board } from '../board'
import Footer from '../components/Footer.astro'
import Header from '../components/Header.astro'
import Base from '../layouts/Base.astro'
import { siteConfig } from '../site.config'

// Strukturerte data for søkemotorer: navnet på nettstedet og foreningen.
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      name: siteConfig.name,
      alternateName: siteConfig.fullName,
      url: `${siteConfig.url}/`,
      inLanguage: 'nb',
    },
    {
      '@type': 'Organization',
      name: siteConfig.name,
      alternateName: siteConfig.fullName,
      url: `${siteConfig.url}/`,
      ...(siteConfig.contactEmail ? { email: siteConfig.contactEmail } : {}),
    },
  ],
}

const events = [
  {
    title: 'ESAF-helg',
    text: 'En helg i Trondheim der alumni og studenter møtes, med workshops og veiledning av teamene som går på Entreprenørskolen nå.',
  },
  {
    title: 'ESAF-talks',
    text: 'Faglige samtaler der folk fra nettverket deler erfaringer med hverandre.',
  },
  {
    title: 'Sosiale samlinger',
    text: 'Sosiale arrangementer som holder kontakten ved like, på tvers av kull.',
  },
]
---

<Base>
  <script
    is:inline
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(structuredData)}
  />
  <Header />
  <main id="innhold">
    <section class="hero" aria-labelledby="hero-title">
      <div class="wrap">
        <h1 id="hero-title">
          Nettverket som varer etter <em>Entreprenørskolen.</em>
        </h1>
        <div class="hero-foot">
          <p class="lead">
            ESAF samler studenter og alumni fra NTNUs Entreprenørskole. På tvers av kull deler vi
            erfaringer, hjelper hverandre med nye ideer og bygger forbindelser som varer etter
            studietiden.
          </p>
          <p class="hero-links">
            <a class="arrow" href="#kontakt">
              Ta kontakt
            </a>
            <a class="arrow" href="#om">
              Les mer om ESAF
            </a>
          </p>
        </div>
      </div>
    </section>

    <section id="om" class="section" aria-labelledby="om-title">
      <div class="wrap">
        <div class="split">
          <h2 id="om-title">Fra studieprogram til livslangt nettverk</h2>
          <div>
            <p>
              NTNUs Entreprenørskole er et toårig masterprogram i entreprenørskap ved NTNU i
              Trondheim. Studentene kombinerer fag i strategi, økonomi og forretningsutvikling med å
              bygge et eget selskap i tverrfaglige team.
            </p>
            <p>
              ESAF er et tverrfaglig nettverk av studenter og alumni fra Entreprenørskolen. Ifølge
              NTNU fortsetter om lag halvparten av kandidatene med selskapet de startet under
              studiet. Det er mye erfaring å dele, og ESAF gjør det lettere å finne hverandre etter
              studietiden.
            </p>
            <p>
              <a href={siteConfig.schoolUrl}>Les om studiet hos NTNU</a>
              <span aria-hidden="true"> · </span>
              <a href={siteConfig.schoolSiteUrl}>entreprenorskolen.no</a>
            </p>
          </div>
        </div>
      </div>
    </section>

    <section id="fellesskap" class="section" aria-labelledby="fellesskap-title">
      <div class="wrap">
        <div class="split">
          <h2 id="fellesskap-title">Møteplasser for studenter og alumni</h2>
          <p class="intro">
            Gjennom ESAF-helg, faglige samtaler og sosiale samlinger møtes folk som bygger
            selskaper, utforsker nye muligheter og vil hjelpe neste kull videre.
          </p>
        </div>
        <ul class="events">
          {events.map((e) => (
            <li>
              <h3>{e.title}</h3>
              <p>{e.text}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section id="sponsorer" class="section" aria-labelledby="sponsorer-title">
      <div class="wrap split">
        <h2 id="sponsorer-title">Sponsorer og samarbeid</h2>
        <div>
          <p class="intro">
            ESAF drives av alumni, og vi ser alltid etter sponsorer og samarbeidspartnere til
            arrangementene våre. Vil bedriften din støtte miljøet, eller møte studenter og alumni
            som bygger selskaper? Ta kontakt med styret.
          </p>
          <p>
            <a class="arrow" href="/sponsorer">
              Les mer om å bli sponsor
            </a>
          </p>
        </div>
      </div>
    </section>

    {board.members.length > 0 && (
      <section id="styret" class="section" aria-labelledby="styret-title">
        <div class="wrap split">
          <h2 id="styret-title">Styret {board.year}</h2>
          <ul class="board">
            {board.members.map((name) => (
              <li>{name}</li>
            ))}
          </ul>
        </div>
      </section>
    )}

    <section id="kontakt" class="section" aria-labelledby="kontakt-title">
      <div class="wrap">
        <h2 id="kontakt-title">Ta kontakt med styret</h2>
        {siteConfig.contactEmail ? (
          <>
            <p class="intro">
              Spørsmål om foreningen, arrangementer eller samarbeid? Send en{' '}
              <span class="nowrap">e-post</span> til
            </p>
            <p class="email">
              <a href={`mailto:${siteConfig.contactEmail}`}>{siteConfig.contactEmail}</a>
            </p>
          </>
        ) : (
          <p class="intro">Kontaktadressen til styret publiseres her før lansering.</p>
        )}
        {siteConfig.facebookUrl && (
          <p>
            Du finner oss også på <a href={siteConfig.facebookUrl}>Facebook</a>.
          </p>
        )}
      </div>
    </section>
  </main>
  <Footer />
</Base>

<style>
  .hero {
    padding-block: clamp(4rem, 10vw, 7.5rem) clamp(4rem, 9vw, 6.5rem);
  }
  .hero h1 {
    max-width: 16ch;
    hyphens: manual;
  }
  @media (max-width: 34rem) {
    .hero h1 {
      hyphens: auto;
    }
  }
  .hero h1 em {
    color: var(--accent);
    white-space: nowrap;
  }
  @media (max-width: 34rem) {
    .hero h1 em {
      white-space: normal;
    }
  }
  .hero-foot {
    display: grid;
    gap: 1.5rem 4rem;
    margin-top: clamp(2.5rem, 6vw, 4.5rem);
    align-items: end;
  }
  @media (min-width: 52rem) {
    .hero-foot {
      grid-template-columns: 1.4fr 1fr;
    }
  }
  .lead {
    font-size: clamp(1.15rem, 2vw, 1.35rem);
    line-height: 1.5;
    color: var(--ink-soft);
    margin: 0;
  }
  .hero-links {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    margin: 0;
  }
  .section {
    padding-bottom: clamp(3.5rem, 8vw, 6rem);
  }
  .section .wrap {
    padding-top: clamp(3.5rem, 8vw, 6rem);
    border-top: 1px solid var(--line);
  }
  .split {
    display: grid;
    gap: 1.5rem 5rem;
  }
  @media (min-width: 52rem) {
    .split {
      grid-template-columns: 1fr 1.3fr;
    }
  }
  .split h2 {
    max-width: 18ch;
  }
  .intro {
    font-size: 1.15rem;
    color: var(--ink-soft);
  }

  .events {
    list-style: none;
    margin: 3rem 0 0;
    padding: 0;
  }
  .events li {
    display: grid;
    gap: 0.5rem 5rem;
    padding-block: 1.75rem;
    border-top: 1px solid var(--line);
  }
  .events h3,
  .events p {
    margin: 0;
  }
  .events p {
    color: var(--ink-soft);
  }
  @media (min-width: 52rem) {
    .events li {
      grid-template-columns: 1fr 1.3fr;
      align-items: baseline;
    }
  }

  .board {
    list-style: none;
    margin: 0;
    padding: 0;
    columns: 15rem 2;
    column-gap: 2.5rem;
    font-family: var(--serif);
    font-size: clamp(1.3rem, 2.2vw, 1.6rem);
    line-height: 1.3;
  }
  .board li {
    break-inside: avoid;
    padding-block: 0.25rem;
  }

  .email {
    font-family: var(--serif);
    font-size: clamp(1.75rem, 5.5vw, 4rem);
    letter-spacing: -0.02em;
    line-height: 1.1;
    max-width: none;
    margin-bottom: 1.25rem;
    overflow-wrap: anywhere;
  }
  .email a {
    text-decoration-thickness: 2px;
    text-underline-offset: 0.15em;
  }
</style>
