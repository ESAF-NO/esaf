{
  // Cloudflare Workers Static Assets: kun statiske filer, ingen Worker-kode.
  // CI deployer automatisk ved push til main. Se README for oppsett og manuell deploy.
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "esaf-site",
  "compatibility_date": "2026-10-28",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
  },
  // Legg til når esaf.no skal peke hit (krever eksplisitt beslutning), og sett samtidig
  // "workers_dev": false, så siden ikke også ligger åpent på workers.dev:
  // "routes": [
  //   { "pattern": "esaf.no", "custom_domain": true },
  //   { "pattern": "www.esaf.no", "custom_domain": true }
  // ]
}
